{
  "name": "instant-present",
  "version": "1.0.0",
  "description": "Base Next.js + Payload CMS + Tailwind pour un site vitrine",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack --no-server-fast-refresh",
    "dev:turbo": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack --no-server-fast-refresh",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "ensure:globals": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx/esm ./scripts/ensure-globals.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "migrate:sqlite-to-postgres": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx/esm ./scripts/migrate-sqlite-to-postgres.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "repair:sqlite-globals": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx/esm ./scripts/repair-sqlite-globals.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "sync:default-content": "cross-env NODE_OPTIONS=--no-deprecation node --import tsx/esm ./scripts/sync-default-content.ts",
    "test": "npm run test:int && npm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "build:preview": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" node --import tsx/esm ./scripts/build-pages-preview.ts",
    "check:preview": "node --import tsx/esm ./scripts/check-pages-preview.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.81.0",
    "@payloadcms/db-sqlite": "3.81.0",
    "@payloadcms/next": "3.81.0",
    "@payloadcms/richtext-lexical": "3.81.0",
    "@payloadcms/ui": "3.81.0",
    "@tailwindcss/postcss": "^4.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "nodemailer": "^8.0.7",
    "payload": "3.81.0",
    "pg": "^8.21.0",
    "postcss": "^8.5.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.34.2",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.1",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
